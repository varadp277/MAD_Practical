<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#153666"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvBookingTurfName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turf Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/tvBookingUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booked By: User"
            android:layout_marginTop="4dp"
            android:textStyle="italic"
            android:textColor="@color/accent"/>

        <TextView
            android:id="@+id/tvBookingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: 12/12/2024"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvBookingSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Slot: 10:00 AM - 11:00 AM"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvBookingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Confirmed"
            android:layout_marginTop="12dp"
            android:textColor="#00E676"
            android:textStyle="bold"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
